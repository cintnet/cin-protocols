{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cin.foundation/schemas/standards/agent-reliability-profile-v0.1.json",
  "title": "AgentReliabilityProfile",
  "version": "0.1.0",
  "description": "Draft schema for machine-readable Agent Reliability Profiles establishing assurance ladders, operational error bounds, and deterministic handoff contract anchors.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "agent_id",
    "issued_at",
    "expires_at",
    "assurance_level",
    "domain",
    "operational_bounds",
    "error_tolerances",
    "handoff_governance",
    "fallback_policy",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^arp-[a-zA-Z0-9_-]+$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "assurance_level": {
      "type": "string",
      "enum": [
        "asserted",
        "validated",
        "verified"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "financial_advisory",
        "healthcare_records",
        "operational_infrastructure",
        "personal_twin",
        "general_assistant"
      ]
    },
    "operational_bounds": {
      "type": "object",
      "required": [
        "max_consecutive_steps",
        "max_daily_invocations",
        "max_exposure_units",
        "action_allowlist"
      ],
      "properties": {
        "max_consecutive_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_daily_invocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_exposure_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "action_allowlist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "error_tolerances": {
      "type": "object",
      "required": [
        "max_error_rate_bps",
        "max_drift_tolerance_bps"
      ],
      "properties": {
        "max_error_rate_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_drift_tolerance_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "additionalProperties": false
    },
    "handoff_governance": {
      "type": "object",
      "required": [
        "contract_anchor_hash",
        "validator_mode",
        "halt_on_failure"
      ],
      "properties": {
        "contract_anchor_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validator_mode": {
          "type": "string",
          "enum": [
            "deterministic_gate",
            "human_gate"
          ]
        },
        "halt_on_failure": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fallback_policy": {
      "type": "object",
      "required": [
        "on_breach",
        "designated_supervisor_id"
      ],
      "properties": {
        "on_breach": {
          "type": "string",
          "enum": [
            "halt",
            "escalate_to_human",
            "safe_state"
          ]
        },
        "designated_supervisor_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "signer_id",
          "algorithm",
          "signature_hex"
        ],
        "properties": {
          "signer_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "ed25519"
            ]
          },
          "signature_hex": {
            "type": "string",
            "pattern": "^[a-f0-9]{128}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
