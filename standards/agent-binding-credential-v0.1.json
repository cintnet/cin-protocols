{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cin.foundation/schemas/standards/agent-binding-credential-v0.1.json",
  "title": "AgentBindingCredential",
  "version": "0.1.0",
  "description": "Draft schema for machine-checkable agent binding credentials under Spec 03, Floor Right F1, and articles/the-second-internet.md.",
  "type": "object",
  "required": [
    "schema_version",
    "credential_id",
    "credential_type",
    "issued_at",
    "expires_at",
    "issuer",
    "holder",
    "agent_subject",
    "compute_budget",
    "permissions",
    "revocation",
    "proof"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "credential_id": { "type": "string", "pattern": "^urn:cin:credential:bind-[a-zA-Z0-9_-]+$" },
    "credential_type": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "issuer": {
      "type": "object",
      "required": ["issuer_id", "name", "verification_method", "issuer_type"],
      "properties": {
        "issuer_id": { "type": "string", "pattern": "^did:[a-z0-9]+:[a-zA-Z0-9._:-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 128 },
        "verification_method": { "type": "string", "pattern": "^did:[a-z0-9]+:[a-zA-Z0-9._:-]+#keys-[0-9]+$" },
        "issuer_type": { "type": "string", "enum": ["community_attestation", "institutional_registry", "federated_cooperative"] }
      },
      "additionalProperties": false
    },
    "holder": {
      "type": "object",
      "required": ["holder_id", "binding_kind", "binding_commitment"],
      "properties": {
        "holder_id": { "type": "string", "pattern": "^did:[a-z0-9]+:[a-zA-Z0-9._:-]+$" },
        "binding_kind": { "type": "string", "enum": ["person", "organisation"] },
        "personhood_credential_ref": { "type": ["string", "null"] },
        "organisation_ref": { "type": ["string", "null"] },
        "binding_commitment": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      },
      "additionalProperties": false
    },
    "agent_subject": {
      "type": "object",
      "required": ["agent_id", "model_family", "model_version", "runtime_hash", "priors_declared"],
      "properties": {
        "agent_id": { "type": "string", "pattern": "^agent-[a-zA-Z0-9_-]+$" },
        "model_family": {
          "type": "string",
          "enum": [
            "claude-3-5",
            "claude-3-7",
            "gemini-2-5",
            "gemini-3-8",
            "gpt-4-5",
            "gpt-5",
            "open-weights-local",
            "deterministic-engine"
          ]
        },
        "model_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "runtime_hash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "priors_declared": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "compute_budget": {
      "type": "object",
      "required": ["max_tokens_per_hour", "max_parallel_threads", "daily_compute_units", "rate_limit_per_minute"],
      "properties": {
        "max_tokens_per_hour": { "type": "integer", "minimum": 1000 },
        "max_parallel_threads": { "type": "integer", "minimum": 1, "maximum": 64 },
        "daily_compute_units": { "type": "integer", "minimum": 1 },
        "rate_limit_per_minute": { "type": "integer", "minimum": 1, "maximum": 1200 }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lease_id", "scope", "allowed_actions", "granted_at", "expires_at", "revocable", "is_revoked"],
        "properties": {
          "lease_id": { "type": "string", "pattern": "^lease-[a-zA-Z0-9_-]+$" },
          "scope": { "type": "string", "minLength": 3, "maxLength": 128 },
          "allowed_actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "granted_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "revocable": { "type": "boolean", "const": true },
          "is_revoked": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "revocation": {
      "type": "object",
      "required": ["revocable", "is_revoked", "revocation_list_url"],
      "properties": {
        "revocable": { "type": "boolean", "const": true },
        "is_revoked": { "type": "boolean" },
        "revocation_list_url": { "type": "string", "format": "uri" },
        "revoked_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "required": ["proof_type", "created", "verification_method", "proof_purpose", "signature_hex"],
      "properties": {
        "proof_type": { "type": "string", "enum": ["Ed25519Signature2020", "JsonWebSignature2020", "EcdsaSecp256k1Signature2019"] },
        "created": { "type": "string", "format": "date-time" },
        "verification_method": { "type": "string" },
        "proof_purpose": { "type": "string", "const": "assertionMethod" },
        "signature_hex": { "type": "string", "pattern": "^[0-9a-fA-F]{64,128}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
